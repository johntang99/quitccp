NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:4020

# Supabase (single project)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
SUPABASE_STORAGE_BUCKET=media

# App secrets
JWT_SECRET=change-me
MFA_REQUIRED=false
# Salt for hashing client addresses on the public intake endpoints. Raw IPs are
# never stored; this salt turns them into an abuse-throttling token only. Set a
# long random value in production -- without it each route bundle falls back to
# its own random salt, so the same client hashes differently per endpoint.
INTAKE_HASH_SALT=change-me
SEED_ADMIN_EMAIL=admin@quitccp.org
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_ROLE=super_admin
SEED_ADMIN_MFA_SECRET=JBSWY3DPEHPK3PXP
SEED_SERVICE_EMAIL=service-admin@quitccp.org
SEED_SERVICE_PASSWORD=change-me
SEED_SERVICE_ROLE=service_admin
SEED_SERVICE_MFA_SECRET=JBSWY3DPEHPK3PXP

# Optional integrations
RESEND_API_KEY=
RESEND_FROM=
CONTACT_FALLBACK_TO=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Search backend strategy
# SEARCH_PRIMARY_BACKEND: pg_trgm | meilisearch
SEARCH_PRIMARY_BACKEND=meilisearch
# SEARCH_DUAL_READ: when true, primary response returns immediately while secondary backend is queried in background for comparison logs
SEARCH_DUAL_READ=true

# Optional Meilisearch backend
MEILI_HOST=http://127.0.0.1:7700
# Use either MEILI_MASTER_KEY or MEILI_SEARCH_API_KEY
MEILI_MASTER_KEY=
MEILI_SEARCH_API_KEY=
MEILI_INDEX_ARTICLES=articles

# Optional migration input
# WP_BASE_URL=https://www.tuidang.org
